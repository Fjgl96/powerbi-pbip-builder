{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.153.json",
  "name": "Tema Elite IBCS",
  "dataColors": ["#0C3549", "#6B7C8C", "#44C088", "#ED7373", "#F2C14E", "#2E86AB", "#B07AA1", "#E07B39"],
  "good": "#44C088",
  "neutral": "#F2C14E",
  "bad": "#ED7373",
  "maximum": "#44C088",
  "center": "#F2C14E",
  "minimum": "#ED7373",
  "background": "#E9EEF3",
  "foreground": "#0C3549",
  "foregroundNeutralSecondary": "#5A6B7B",
  "foregroundNeutralTertiary": "#5A6B7B",
  "backgroundLight": "#F1F5F9",
  "backgroundNeutral": "#E2E8EF",
  "tableAccent": "#0C3549",
  "textClasses": {
    "callout": { "fontSize": 27, "fontFace": "Segoe UI Semibold", "color": "#0C3549" },
    "title": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#0C3549" },
    "header": { "fontSize": 11, "fontFace": "Segoe UI Semibold", "color": "#0C3549" },
    "label": { "fontSize": 10, "fontFace": "Segoe UI Variable, Segoe UI, sans-serif", "color": "#1E3A4F" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "border": [{ "show": true, "color": { "solid": { "color": "#E2E8EF" } }, "radius": 6 }],
        "dropShadow": [{ "show": false }],
        "padding": [{ "top": 8, "bottom": 8, "left": 8, "right": 8 }],
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "visualHeader": [{ "show": false }]
      }
    },
    "textbox": {
      "*": {
        "padding": [{ "top": 0, "bottom": 0, "left": 0, "right": 0 }],
        "background": [{ "show": false }],
        "border": [{ "show": false }]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [{
          "autoSizeColumnWidth": true,
          "columnAdjustment": "growToFit",
          "backColor": { "solid": { "color": "#F1F5F9" } },
          "fontColor": { "solid": { "color": "#0C3549" } },
          "bold": true,
          "fontSize": 10
        }],
        "values": [{
          "fontSize": 10,
          "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
          "backColorSecondary": { "solid": { "color": "#F9FAFB" } },
          "fontColorPrimary": { "solid": { "color": "#1E3A4F" } },
          "fontColorSecondary": { "solid": { "color": "#1E3A4F" } }
        }],
        "grid": [{ "gridlineColor": { "solid": { "color": "#EEF2F6" } }, "rowPadding": 4, "outlineColor": { "solid": { "color": "#E2E8EF" } }, "outlineWeight": 1 }]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [{
          "autoSizeColumnWidth": true,
          "columnAdjustment": "growToFit",
          "backColor": { "solid": { "color": "#F1F5F9" } },
          "fontColor": { "solid": { "color": "#0C3549" } },
          "bold": true,
          "fontSize": 10
        }],
        "rowHeaders": [{ "bold": true, "fontSize": 10, "fontColor": { "solid": { "color": "#0C3549" } } }],
        "values": [{
          "fontSize": 10,
          "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
          "backColorSecondary": { "solid": { "color": "#F9FAFB" } },
          "fontColorPrimary": { "solid": { "color": "#1E3A4F" } },
          "fontColorSecondary": { "solid": { "color": "#1E3A4F" } }
        }],
        "grid": [{ "gridlineColor": { "solid": { "color": "#FFFFFF" } }, "rowPadding": 4 }]
      }
    },
    "cardVisual": {
      "*": {
        "value": [{ "bold": true, "fontSize": 22, "$id": "default" }],
        "label": [{ "show": true, "$id": "default" }],
        "cardCalloutArea": [{ "paddingUniform": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E2E8EF" } }, "radius": 6 }],
        "title": [{ "show": false }],
        "spacing": [{ "customizeSpacing": true, "verticalSpacing": -6 }],
        "padding": [{ "top": 0, "bottom": 0, "left": 0, "right": 0 }]
      }
    },
    "barChart": {
      "*": {
        "labels": [{ "show": true, "fontSize": 10, "labelPosition": "OutsideEnd", "color": { "solid": { "color": "#1E3A4F" } } }],
        "valueAxis": [{ "show": false, "gridlineShow": false, "showAxisTitle": false }],
        "categoryAxis": [{
          "show": true,
          "fontSize": 10,
          "labelColor": { "solid": { "color": "#5A6B7B" } },
          "showAxisTitle": false,
          "innerPadding": 30,
          "gridlineShow": false
        }],
        "dataPoint": [{ "borderShow": false }],
        "legend": [{ "show": false }],
        "title": [{ "fontSize": 12, "fontColor": { "solid": { "color": "#0C3549" } } }]
      }
    },
    "clusteredBarChart": {
      "*": {
        "labels": [{ "show": true, "fontSize": 10, "labelPosition": "OutsideEnd", "color": { "solid": { "color": "#1E3A4F" } } }],
        "valueAxis": [{ "show": false, "gridlineShow": false, "showAxisTitle": false }],
        "categoryAxis": [{
          "show": true,
          "fontSize": 10,
          "labelColor": { "solid": { "color": "#5A6B7B" } },
          "showAxisTitle": false,
          "innerPadding": 30,
          "gridlineShow": false
        }],
        "dataPoint": [{ "borderShow": false }],
        "legend": [{ "show": true, "fontSize": 9, "labelColor": { "solid": { "color": "#5A6B7B" } }, "position": "Top" }],
        "title": [{ "fontSize": 12, "fontColor": { "solid": { "color": "#0C3549" } } }]
      }
    },
    "columnChart": {
      "*": {
        "labels": [{ "show": true, "fontSize": 10, "labelPosition": "OutsideEnd", "color": { "solid": { "color": "#1E3A4F" } } }],
        "valueAxis": [{ "show": false, "gridlineShow": false, "showAxisTitle": false }],
        "categoryAxis": [{
          "show": true,
          "fontSize": 10,
          "labelColor": { "solid": { "color": "#5A6B7B" } },
          "showAxisTitle": false,
          "gridlineShow": false
        }],
        "dataPoint": [{ "borderShow": false }],
        "legend": [{ "show": false }],
        "title": [{ "fontSize": 12, "fontColor": { "solid": { "color": "#0C3549" } } }]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "labels": [{ "show": true, "fontSize": 10, "labelPosition": "OutsideEnd", "color": { "solid": { "color": "#1E3A4F" } } }],
        "valueAxis": [{ "show": false, "gridlineShow": false, "showAxisTitle": false }],
        "categoryAxis": [{
          "show": true,
          "fontSize": 10,
          "labelColor": { "solid": { "color": "#5A6B7B" } },
          "showAxisTitle": false,
          "gridlineShow": false
        }],
        "dataPoint": [{ "borderShow": false }],
        "legend": [{ "show": true, "fontSize": 9, "labelColor": { "solid": { "color": "#5A6B7B" } }, "position": "Top" }],
        "title": [{ "fontSize": 12, "fontColor": { "solid": { "color": "#0C3549" } } }]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [{
          "strokeWidth": 2.5,
          "lineChartType": "smooth",
          "interpolationSmooth": "monotoneX",
          "areaShow": true,
          "areaMatchStrokeColor": true
        }],
        "dataPoint": [{ "transparency": 85 }],
        "labels": [{
          "show": true,
          "labelPosition": "Above",
          "fontSize": 9,
          "color": { "solid": { "color": "#1E3A4F" } },
          "labelDensity": 25
        }],
        "categoryAxis": [{
          "show": true,
          "fontSize": 10,
          "labelColor": { "solid": { "color": "#5A6B7B" } },
          "showAxisTitle": false,
          "gridlineShow": false
        }],
        "valueAxis": [{
          "show": true,
          "fontSize": 9,
          "labelColor": { "solid": { "color": "#5A6B7B" } },
          "showAxisTitle": false,
          "gridlineStyle": "dotted",
          "gridlineColor": { "solid": { "color": "#E2E8EF" } }
        }],
        "legend": [{ "show": true, "fontSize": 9, "labelColor": { "solid": { "color": "#5A6B7B" } }, "position": "Top" }],
        "title": [{ "fontSize": 12, "fontColor": { "solid": { "color": "#0C3549" } } }]
      }
    },
    "lineClusteredColumnComboChart": {
      "*": {
        "labels": [{ "show": false }],
        "valueAxis": [{
          "show": true,
          "gridlineShow": true,
          "gridlineStyle": "dotted",
          "gridlineColor": { "solid": { "color": "#E2E8EF" } },
          "labelColor": { "solid": { "color": "#5A6B7B" } },
          "fontSize": 9,
          "showAxisTitle": false
        }],
        "categoryAxis": [{
          "show": true,
          "fontSize": 10,
          "labelColor": { "solid": { "color": "#5A6B7B" } },
          "showAxisTitle": false,
          "gridlineShow": false
        }],
        "dataPoint": [{ "borderShow": false }],
        "lineStyles": [{ "strokeWidth": 2, "lineChartType": "straight" }],
        "legend": [{ "show": true, "fontSize": 9, "labelColor": { "solid": { "color": "#5A6B7B" } }, "position": "Top" }],
        "title": [{ "fontSize": 12, "fontColor": { "solid": { "color": "#0C3549" } } }]
      }
    },
    "slicer": {
      "*": {
        "header": [{
          "fontFamily": "Segoe UI Semibold",
          "textSize": 10,
          "fontColor": { "solid": { "color": "#0C3549" } },
          "outlineStyle": 0
        }],
        "items": [{
          "fontFamily": "Segoe UI Variable, Segoe UI, sans-serif",
          "textSize": 9,
          "fontColor": { "solid": { "color": "#1E3A4F" } },
          "outlineStyle": 0,
          "padding": 2
        }],
        "date": [{
          "fontFamily": "Segoe UI Variable, Segoe UI, sans-serif",
          "textSize": 9,
          "fontColor": { "solid": { "color": "#1E3A4F" } }
        }]
      }
    }
  }
}
